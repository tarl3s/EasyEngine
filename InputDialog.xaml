<Window x:Class="EasyEngine.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyEngine" SizeToContent="Height" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="ToolWindow" Background="{StaticResource Bg0}" FontFamily="Segoe UI">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" Text="Name" Foreground="{StaticResource Text}" FontSize="13" Margin="0,0,0,8"/>
        <TextBox x:Name="Input" Height="34" FontSize="14"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource CardButton}" Width="90" Height="34" HorizontalContentAlignment="Center" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="OK" Style="{StaticResource AccentButton}" Width="90" Height="34" Click="Ok_Click" IsDefault="True"/>
        </StackPanel>
    </StackPanel>
</Window>
