<Window x:Class="EasyEngine.AnimationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Animations" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg0}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: animation list + ADD ANIMATION -->
        <Border Grid.Column="0" Background="{StaticResource Bg1}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ANIMATIONS" Style="{StaticResource SectionHeader}"/>
                <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,14">
                    <Button Content="＋  ADD ANIMATION" Style="{StaticResource AccentButton}" Height="52" FontSize="15" Click="AddAnimation_Click"/>
                    <Button Content="🎨  Draw a sprite" Style="{StaticResource CardButton}" Height="36" FontSize="13" Margin="0,8,0,0" HorizontalContentAlignment="Center" Click="DrawSprite_Click"/>
                </StackPanel>
                <ListBox x:Name="AnimList" Background="Transparent" BorderThickness="0" Margin="6,0,6,0"
                         SelectionChanged="AnimList_SelectionChanged"/>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="{StaticResource Border}"/>

        <!-- RIGHT: selected animation -->
        <Grid Grid.Column="2">
            <!-- empty state -->
            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🎞" FontSize="54" HorizontalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                <TextBlock Text="No animation selected." Foreground="{StaticResource TextDim}" FontSize="14" Margin="0,10,0,0"/>
                <TextBlock Text="Click “ADD ANIMATION” to create one (idle, walk, jump…)." Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <DockPanel x:Name="Editor" Margin="20" Visibility="Collapsed">
                <!-- header -->
                <Grid DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="AnimTitle" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                        <Button Content="rename" Style="{StaticResource GhostButton}" Height="26" Margin="8,0,0,0" FontSize="11" Foreground="{StaticResource TextDim}" Click="Rename_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DefaultBtn" Content="☆ Set as default" Style="{StaticResource CardButton}" Height="32" Padding="12,0" HorizontalContentAlignment="Center" Click="SetDefault_Click"/>
                        <Button Content="🗑 Delete animation" Style="{StaticResource CardButton}" Height="32" Padding="12,0" Margin="8,0,0,0" HorizontalContentAlignment="Center" Foreground="{StaticResource Danger}" Click="DeleteAnim_Click"/>
                    </StackPanel>
                </Grid>

                <!-- controls -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,16,0,0">
                    <TextBlock Text="FPS" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox x:Name="FpsBox" Width="60" Height="30" Text="10" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="LoopBox" Content="Loop" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="18,0,0,0" IsChecked="True"/>
                    <TextBlock x:Name="FrameCount" Text="" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="18,0,0,0"/>
                </StackPanel>

                <!-- preview -->
                <Border DockPanel.Dock="Top" Height="220" Margin="0,16,0,0" Background="{StaticResource Viewport}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="16" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <TextBlock Text="PREVIEW" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10"/>
                    </Grid>
                </Border>

                <!-- frames -->
                <TextBlock DockPanel.Dock="Top" Text="FRAMES" Style="{StaticResource SectionHeader}" Margin="0,16,0,8"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Content="＋ Add frames" Style="{StaticResource CardButton}" Height="32" Padding="14,0" HorizontalContentAlignment="Center" Click="AddFrames_Click"/>
                    <Button Content="🎨 Draw frame" Style="{StaticResource CardButton}" Height="32" Padding="14,0" Margin="8,0,0,0" HorizontalContentAlignment="Center" Click="DrawFrame_Click"/>
                </StackPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,10,0,0">
                    <WrapPanel x:Name="FramesPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
