<Window x:Class="EasyEngine.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyEngine" Height="560" Width="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}" FontFamily="Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Bg1}">
            <DockPanel Margin="26,30,26,26">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="⬡" Foreground="{StaticResource Accent}" FontSize="46"/>
                    <TextBlock Text="EasyEngine" Foreground="{StaticResource Text}" FontSize="26" FontWeight="Bold" Margin="0,2,0,0"/>
                    <TextBlock Text="The easiest 2D game engine — you bring the art, the AI writes the code." Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="VersionText" Text="v0.13.0" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,6,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <Button Content="＋  New Project" Style="{StaticResource AccentButton}" Height="44" FontSize="14" Click="NewProject_Click"/>
                    <Button Content="📂  Open Project…" Style="{StaticResource CardButton}" Height="44" Margin="0,10,0,0" HorizontalContentAlignment="Center" Click="OpenProject_Click"/>
                    <Button Content="⚙  Settings" Style="{StaticResource GhostButton}" Height="34" Margin="0,8,0,0" HorizontalAlignment="Left" Click="Settings_Click"/>
                    <TextBlock x:Name="OllamaStatus" Text="AI: checking…" Foreground="{StaticResource TextDim}" FontSize="11" Margin="2,16,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1" Margin="30">
            <DockPanel x:Name="RecentPanel">
                <TextBlock DockPanel.Dock="Top" Text="Recent projects" Foreground="{StaticResource Text}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock x:Name="NoRecent" DockPanel.Dock="Top" Text="No projects yet. Click “New Project” to start." Foreground="{StaticResource TextDim}" FontSize="13" Visibility="Collapsed"/>
                <ListBox x:Name="RecentList" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="RecentList_DoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="b" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="b" Property="Background" Value="{StaticResource Bg2}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🎮" FontSize="22" Foreground="{StaticResource Text}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Text}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Path}" Foreground="{StaticResource TextDim}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding LastOpened}" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Grid.Column="3" Content="✏" Style="{StaticResource GhostButton}" Width="32" Height="30" Margin="0,0,2,0"
                                        ToolTip="Rename" Tag="{Binding}" Click="RenameRecent_Click" Loaded="RenameButton_Loaded"/>
                                <Button Grid.Column="4" Content="🗑" Style="{StaticResource GhostButton}" Width="32" Height="30"
                                        Foreground="{StaticResource Danger}" ToolTip="Delete / remove" Tag="{Binding}" Click="DeleteRecent_Click" Loaded="DeleteButton_Loaded"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- new project form -->
            <Border x:Name="NewForm" Background="{StaticResource Bg0}" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" MaxWidth="420">
                    <TextBlock Text="New project" Foreground="{StaticResource Text}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18"/>
                    <TextBlock Text="Game name" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBox x:Name="NewName" Height="36" Text="My Game"/>
                    <TextBlock Text="Location" Foreground="{StaticResource TextDim}" FontSize="12" Margin="0,14,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NewLocation" Grid.Column="0" Height="36" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="…" Style="{StaticResource CardButton}" Width="40" Height="36" Margin="8,0,0,0" HorizontalContentAlignment="Center" Click="BrowseFolder_Click"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                        <Button Content="Cancel" Style="{StaticResource CardButton}" Width="110" Height="38" HorizontalContentAlignment="Center" Margin="0,0,10,0" Click="CancelNew_Click"/>
                        <Button Content="Create" Style="{StaticResource AccentButton}" Width="130" Height="38" Click="CreateNew_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
