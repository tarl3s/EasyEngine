<Window x:Class="EasyEngine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EasyEngine"
        mc:Ignorable="d"
        Title="EasyEngine" Height="760" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg0}" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition x:Name="DockBottomRow" Height="190"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- ===== TOOLBAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="⬡" Foreground="{StaticResource Accent}" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ProjectNameText" Text="EasyEngine" Foreground="{StaticResource Text}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Margin="8,0,14,0"/>
                    <Button Content="New"   Style="{StaticResource GhostButton}" Height="32" Click="New_Click"/>
                    <Button Content="Open"  Style="{StaticResource GhostButton}" Height="32" Click="Open_Click"/>
                    <Button Content="Save"  Style="{StaticResource GhostButton}" Height="32" Click="Save_Click"/>
                    <Button Content="Variables" Style="{StaticResource GhostButton}" Height="32" Click="Variables_Click"/>
                    <Button x:Name="PanelsButton" Content="Panels ▾" Style="{StaticResource GhostButton}" Height="32" Click="PanelsMenu_Click"/>

                    <Border Width="1" Background="{StaticResource Border}" Margin="10,8" />
                    <TextBlock Text="Scene" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="SceneCombo" Width="140" Height="28" VerticalAlignment="Center" SelectionChanged="SceneCombo_SelectionChanged"/>
                    <Button Content="Add Scene"    Style="{StaticResource GhostButton}" Height="28" FontSize="12" Click="AddScene_Click"/>
                    <Button Content="Rename"       Style="{StaticResource GhostButton}" Height="28" FontSize="12" Click="RenameScene_Click"/>
                    <Button Content="Delete"       Style="{StaticResource GhostButton}" Height="28" FontSize="12" Foreground="{StaticResource Danger}" Click="DeleteScene_Click"/>
                    <Button Content="Set as Start" Style="{StaticResource GhostButton}" Height="28" FontSize="12" Click="SetStartScene_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                    <TextBlock x:Name="OllamaDot" Text="●" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <Button Content="Export" Style="{StaticResource GhostButton}" Height="32" Click="Export_Click"/>
                    <Button x:Name="PlayButton" Content="▶  Test" Style="{StaticResource AccentButton}" Width="104" Margin="8,0,0,0" Click="Test_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== MAIN AREA (dockable) ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DockLeftCol" Width="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition x:Name="DockRightCol" Width="360"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="DockLeftHost" Grid.Column="0"/>
            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>

            <!-- CENTER: scene (always here) -->
            <Border Grid.Column="2" Background="#111115">
                <Grid>
                    <ScrollViewer x:Name="SceneScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="Transparent" PreviewMouseWheel="SceneScroll_PreviewMouseWheel">
                        <Border x:Name="SceneFrame" Width="960" Height="540"
                                Background="#1A1A20" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.LayoutTransform>
                                <ScaleTransform x:Name="SceneScale" ScaleX="1" ScaleY="1"/>
                            </Border.LayoutTransform>
                            <Canvas x:Name="SceneCanvas" ClipToBounds="True" Background="Transparent" MouseLeftButtonDown="Canvas_MouseDown"/>
                        </Border>
                    </ScrollViewer>
                    <TextBlock Text="SCENE" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" IsHitTestVisible="False"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12">
                        <TextBlock x:Name="ZoomLabel" Text="100%" Foreground="{StaticResource TextDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="36" TextAlignment="Right"/>
                        <Button Content="－" Style="{StaticResource GhostButton}" Width="30" Height="26" FontSize="13" ToolTip="Zoom out (Ctrl + roda / Ctrl -)" Click="ZoomOut_Click"/>
                        <Button Content="＋" Style="{StaticResource GhostButton}" Width="30" Height="26" FontSize="13" Margin="4,0,0,0" ToolTip="Zoom in (Ctrl + roda / Ctrl +)" Click="ZoomIn_Click"/>
                        <Button Content="Fit" Style="{StaticResource GhostButton}" Width="42" Height="26" FontSize="11" Margin="4,0,0,0" ToolTip="Fit scene (Ctrl 0)" Click="ZoomFit_Click"/>
                        <Button x:Name="GridToggle" Content="Grid: off" Style="{StaticResource GhostButton}" Height="26" FontSize="11" Margin="8,0,0,0" Click="GridToggle_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>
            <Grid x:Name="DockRightHost" Grid.Column="4"/>
        </Grid>

        <GridSplitter x:Name="BottomSplitter" Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource Border}"/>

        <!-- ===== BOTTOM dock region ===== -->
        <Grid x:Name="DockBottomHost" Grid.Row="3"/>

        <!-- ===== STATUS ===== -->
        <Border Grid.Row="4" Background="{StaticResource Accent}">
            <TextBlock x:Name="StatusText" Text="Ready" Foreground="White" FontSize="11" VerticalAlignment="Center" Margin="12,0"/>
        </Border>

        <!-- ===== CARD SHELF (holds dock cards; code moves them into regions) ===== -->
        <Grid x:Name="CardShelf" Grid.Row="1" Visibility="Collapsed">

            <!-- PREFABS -->
            <Border x:Name="CardPrefabs" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <Grid Height="26">
                            <TextBlock Text="PREFABS" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Button Tag="prefabs" Content="⋯" Click="DockMenu_Click" ToolTip="Move / float this panel" HorizontalAlignment="Right" Width="30" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDim}" FontSize="15"/>
                        </Grid>
                    </Border>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,12">
                        <Button Content="＋ Empty Object" Style="{StaticResource CardButton}" Margin="0,0,0,6" HorizontalContentAlignment="Center" Click="AddEmpty_Click"/>
                        <Button Content="Save selection as prefab" Style="{StaticResource GhostButton}" Height="28" FontSize="11" Click="SavePrefab_Click"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Click to add to the selected layer" Foreground="{StaticResource TextDim}" FontSize="11" Margin="12,8,12,6" TextWrapping="Wrap"/>
                    <TextBox x:Name="PrefabSearch" DockPanel.Dock="Top" Margin="12,0,12,8" Padding="4,3" Tag="Search prefabs…" TextChanged="PrefabSearch_TextChanged"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PaletteList" Margin="12,0,12,8"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- AI + INSPECTOR (tabbed) -->
            <Border x:Name="CardAi" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <Grid Height="34" Margin="6,0,2,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="TabAi" Content="AI" Style="{StaticResource CardButton}" Width="86" Height="26" HorizontalContentAlignment="Center" Click="TabAi_Click"/>
                                <Button x:Name="TabInspector" Content="Inspector" Style="{StaticResource CardButton}" Width="86" Height="26" Margin="4,0,0,0" HorizontalContentAlignment="Center" Click="TabInspector_Click"/>
                            </StackPanel>
                            <Button Tag="ai" Content="⋯" Click="DockMenu_Click" ToolTip="Move / float this panel" HorizontalAlignment="Right" Width="30" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDim}" FontSize="15"/>
                        </Grid>
                    </Border>
                    <Grid>
                    <ScrollViewer x:Name="InspectorScroll" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel x:Name="InspectorRoot" Margin="12,0,12,12"/>
                    </ScrollViewer>
                    <DockPanel x:Name="AiPanel">
                        <StackPanel DockPanel.Dock="Top" Margin="12,8,12,6">
                            <Button x:Name="AiConfigToggle" Click="AiConfigToggle_Click" Style="{StaticResource CardButton}" HorizontalContentAlignment="Stretch" Padding="8,5">
                                <TextBlock x:Name="AiConfigSummary" FontSize="12" Text="⚙ AI settings"/>
                            </Button>
                            <StackPanel x:Name="AiConfigPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                <!-- EASY SETUP: turn on the free smart AI in 3 taps -->
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="Turn on the smart AI — it's free" Margin="0,0,0,2"/>
                                <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}"
                                           Text="Pick ONE below. Tap &quot;Get free key&quot;, sign in, copy the key it shows, and paste it here. No credit card. You only do this once."/>
                                <StackPanel x:Name="FreeKeysHost" Margin="0,8,0,0"/>

                                <!-- ADVANCED: hidden by default -->
                                <Button x:Name="AdvancedToggle" Click="AdvancedToggle_Click" Style="{StaticResource CardButton}" HorizontalContentAlignment="Left" Padding="8,5" Margin="0,12,0,0">
                                    <TextBlock x:Name="AdvancedToggleText" FontSize="11" Foreground="{StaticResource TextDim}" Text="▸ Advanced — pick a model, paid keys, offline AI"/>
                                </Button>
                                <StackPanel x:Name="AdvancedPanel" Visibility="Collapsed" Margin="0,6,0,0">
                                    <TextBlock Text="Which AI to use" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="StrengthCombo" SelectionChanged="StrengthCombo_SelectionChanged">
                                        <ComboBoxItem Content="☁ Cloud — Auto (rotate free providers)" Tag="cloud:auto"/>
                                        <ComboBoxItem Content="☁ Groq 120B (free)"   Tag="cloud:groq"/>
                                        <ComboBoxItem Content="☁ Groq 20B (free, fast)" Tag="cloud:groq|openai/gpt-oss-20b"/>
                                        <ComboBoxItem Content="☁ Gemini (free)"      Tag="cloud:gemini"/>
                                        <ComboBoxItem Content="☁ OpenRouter (free)"  Tag="cloud:openrouter"/>
                                        <ComboBoxItem Content="☁ Mistral (free)"     Tag="cloud:mistral"/>
                                        <ComboBoxItem Content="💳 OpenAI / ChatGPT (your API key)" Tag="cloud:openai"/>
                                        <ComboBoxItem Content="💳 Claude / Anthropic (your API key)" Tag="cloud:anthropic"/>
                                        <ComboBoxItem Content="💳 DeepSeek (your API key)" Tag="cloud:deepseek"/>
                                        <ComboBoxItem Content="💳 Custom — any OpenAI-compatible (your API key)" Tag="cloud:custom"/>
                                        <ComboBoxItem Content="⚡ Local — fastest (1.5b)"        Tag="qwen2.5-coder:1.5b"/>
                                        <ComboBoxItem Content="✨ Local+ — smarter, still light (3b)" Tag="qwen2.5-coder:3b"/>
                                        <ComboBoxItem Content="⚖ Local — balanced (7b)"         Tag="qwen2.5-coder:7b"/>
                                        <ComboBoxItem Content="🔥 Local — needs GPU/RAM (14b)"   Tag="qwen2.5-coder:14b"/>
                                        <ComboBoxItem Content="🛠 Custom local model…"           Tag=""/>
                                    </ComboBox>
                                    <TextBox x:Name="CustomModel" Visibility="Collapsed" Margin="0,6,0,0" TextChanged="CustomModel_TextChanged"/>
                                    <TextBlock Text="Paid keys — your own account, billed per use" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,2"/>
                                    <StackPanel x:Name="PaidKeysHost"/>
                                    <TextBlock x:Name="OllamaStatus" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Text="Checking Ollama…"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="AiModeBuild" Grid.Column="0" Content="🔨 Build" Style="{StaticResource CardButton}" HorizontalContentAlignment="Center" Margin="0,0,4,0" Click="AiBuild_Click"/>
                                <Button x:Name="AiModeBrainstorm" Grid.Column="1" Content="💡 Brainstorm" Style="{StaticResource CardButton}" HorizontalContentAlignment="Center" Margin="4,0,0,0" Click="AiBrainstorm_Click"/>
                            </Grid>
                            <TextBlock x:Name="AiHint" Margin="2,6,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Text="Describe what to build."/>
                            <Border Margin="0,6,0,0" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="5" Padding="8,5">
                                <TextBlock x:Name="AiTarget" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource TextDim}" Text="Target: auto-detect."/>
                            </Border>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="AiAddImages" Content="📎 Add files (images / audio)" Style="{StaticResource CardButton}" Height="28" Padding="10,0" HorizontalContentAlignment="Center" Click="AddImages_Click"/>
                            </StackPanel>
                            <WrapPanel x:Name="AiImages" Margin="0,0,0,6"/>
                            <TextBox x:Name="AiInput" Height="70" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                            <Button x:Name="AiSend" Content="Build it" Style="{StaticResource AccentButton}" Margin="0,8,0,0" Click="AiSend_Click"/>
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12,0,12,0">
                            <StackPanel x:Name="AiLog"/>
                        </ScrollViewer>
                    </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- LAYERS -->
            <Border x:Name="CardLayers" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <Grid Height="26">
                            <TextBlock Text="SCENE LAYERS" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="＋" Style="{StaticResource GhostButton}" Width="28" Height="22" ToolTip="Add layer" Click="AddLayer_Click"/>
                                <Button Tag="layers" Content="⋯" Click="DockMenu_Click" ToolTip="Move / float this panel" Width="30" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDim}" FontSize="15"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ListBox x:Name="LayersList" Background="Transparent" BorderThickness="0" Margin="6,6,6,6" SelectionChanged="LayersList_SelectionChanged"/>
                </DockPanel>
            </Border>

            <!-- OBJECTS -->
            <Border x:Name="CardObjects" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Border}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1">
                        <Grid Height="26">
                            <TextBlock x:Name="ObjectsHeader" Text="OBJECTS" Foreground="{StaticResource TextDim}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Button Tag="objects" Content="⋯" Click="DockMenu_Click" ToolTip="Move / float this panel" HorizontalAlignment="Right" Width="30" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextDim}" FontSize="15"/>
                        </Grid>
                    </Border>
                    <TextBox x:Name="ObjectSearch" DockPanel.Dock="Top" Margin="8,6,8,6" Padding="4,3" Tag="Search objects…" TextChanged="ObjectSearch_TextChanged"/>
                    <ListBox x:Name="ObjectsList" Background="Transparent" BorderThickness="0" Margin="6,0,6,6" SelectionChanged="ObjectsList_SelectionChanged"/>
                </DockPanel>
            </Border>

        </Grid>
    </Grid>
</Window>
