<Window x:Class="EasyEngine.PlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Testar — EasyEngine" Height="620" Width="1000"
        WindowStartupLocation="CenterOwner"
        Background="Black" FontFamily="Segoe UI">
    <!-- Shell: game area on the left, optional debug console on the right (F1) -->
    <Grid x:Name="Shell">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="ConsoleSplitCol" Width="0"/>
            <ColumnDefinition x:Name="ConsoleCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- Root = the game area (camera, HUD and every layout helper size from it).
             Transparent background so it receives the mouse everywhere inside it. -->
        <Grid x:Name="Root" Grid.Column="0" ClipToBounds="True" Background="Transparent">
            <!-- céu: sol e lua (tela fixa, atrás de TUDO) -->
            <Canvas x:Name="Sky" IsHitTestVisible="False"/>
            <!-- mundo (sofre a câmera) -->
            <Canvas x:Name="World"/>
            <!-- escuridão ambiente (tela cheia, fixa) -->
            <Rectangle x:Name="Darkness" Fill="Black" IsHitTestVisible="False" Opacity="0"/>
            <!-- luzes (acima da escuridão, seguem a câmera) -->
            <Canvas x:Name="Lights" IsHitTestVisible="False"/>
            <!-- camadas fixas de interface (não sofrem a câmera) -->
            <Canvas x:Name="Hud"/>

            <!-- cutscene / boss overlays: their state lives in the logic (PlayWindow.Sequences.cs / .Boss.cs), drawn in Render -->
            <Rectangle x:Name="FadeRect" Fill="Black" Opacity="0" IsHitTestVisible="False"/>
            <Rectangle x:Name="BarTop" Fill="Black" Height="0" VerticalAlignment="Top" IsHitTestVisible="False"/>
            <Rectangle x:Name="BarBottom" Fill="Black" Height="0" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
            <TextBlock x:Name="BigTitle" Opacity="0" FontSize="56" FontWeight="Bold" Foreground="White" TextAlignment="Center" TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0" IsHitTestVisible="False">
                <TextBlock.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="18" Color="Black" Opacity="0.9"/></TextBlock.Effect>
            </TextBlock>
            <Border x:Name="BossBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,64,0,0" Width="520" IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="BossBarName" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <TextBlock.Effect><DropShadowEffect ShadowDepth="0" BlurRadius="6" Color="Black" Opacity="0.9"/></TextBlock.Effect>
                    </TextBlock>
                    <Border Height="18" CornerRadius="5" Background="#CC1A1A22" BorderBrush="#AAFFFFFF" BorderThickness="1" Padding="2">
                        <Rectangle x:Name="BossBarFill" Fill="#E5484D" HorizontalAlignment="Left" RadiusX="3" RadiusY="3" Width="0"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- dialogue box -->
            <Border x:Name="DialogBox" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="40,0,40,32"
                    Background="#E6101014" BorderBrush="#2EE0E0E0" BorderThickness="1" CornerRadius="10" Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="DialogSpeaker" Foreground="#18B98A" FontWeight="Bold" FontSize="14" Margin="0,0,0,4"/>
                    <TextBlock x:Name="DialogText" Foreground="White" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock Text="▼ Enter" Foreground="#8C8C97" FontSize="11" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock x:Name="BarHint" Text="F2: show the bar" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16,12,0,0"
                       Foreground="#CCCCCC" Background="#88000000" Padding="8,4" FontSize="12" Visibility="Collapsed" IsHitTestVisible="False"/>
            <!-- top HUD -->
            <Border x:Name="TopBar" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12"
                    Background="#AA000000" CornerRadius="8" Padding="12,8">
                <StackPanel Orientation="Horizontal">
                    <Button Content="⏹ Stop (Esc)" Click="Stop_Click" Focusable="False"
                            Background="#E5484B" Foreground="White" BorderThickness="0" Padding="12,6" Cursor="Hand"/>
                    <Button x:Name="ConsoleBtn" Content="▤ Console (F1)" Click="ConsoleBtn_Click" Focusable="False" Margin="8,0,0,0"
                            Background="#2A2C36" Foreground="White" BorderThickness="0" Padding="10,6" Cursor="Hand"/>
                    <TextBlock x:Name="Hint" Foreground="#CCCCCC" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"
                               Text="Arrows / A-D move · Space jump · Esc exit"/>
                    <TextBlock x:Name="FpsText" Foreground="#8C8C97" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <Button x:Name="HideBarBtn" Content="✕ Hide (F2)" ToolTip="Hide this bar. F2 hides it and brings it back." Click="HideBar_Click" Focusable="False" Margin="12,0,0,0"
                            Background="Transparent" Foreground="#CCCCCC" BorderThickness="0" Padding="6,2" Cursor="Hand"/>
                </StackPanel>
            </Border>
        </Grid>

        <GridSplitter x:Name="ConsoleSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Visibility="Collapsed"
                      Background="#2C2F3A" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" Focusable="False"/>
        <ContentControl x:Name="ConsoleHost" Grid.Column="2" Visibility="Collapsed" Focusable="False"/>
    </Grid>
</Window>
